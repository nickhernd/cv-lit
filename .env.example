# Copia este fichero a ".env" (ya está en .gitignore, nunca se commitea) y
# rellena los valores reales. Los scripts de acces_api/ y el backend los leen
# de variables de entorno; acces_api/obscape_api.py también carga un .env en
# la raíz del repo automáticamente si existe.

# Credenciales de la API de Obscape (panel de Obscape -> API access)
OBSCAPE_USERNAME=
OBSCAPE_API_KEY=

# Opcional: exige esta API key en el header para todo /api/* del backend.
# Sin definir, el backend queda abierto (solo pensado para uso local/desktop).
CVLIT_API_KEY=

# Opcional: redirige dónde vive la app de escritorio / dev sus datos e imágenes.
# CVLIT_DATA_DIR=
# CVLIT_CALIBRATION_DIR=
